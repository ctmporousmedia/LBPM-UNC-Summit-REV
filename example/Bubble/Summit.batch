#!/bin/bash
# Begin LSF Directives
#BSUB -P ENG101
#BSUB -W 118
#BSUB -nnodes 2
#BSUB -J cpf
#BSUB -o jobname.cpf
#BSUB -e jobname.cpf
#BSUB -alloc_flags "smt1 NVME"
### End BSUB Options and begin shell commands
 
module load cmake/3.11.3
module load gcc/7.4.0
module load spectrum-mpi
# For numpy
module load python/2.7.15-anaconda2-5.3.0
module load cuda
module load essl
export OMP_NUM_THREADS=7
export PAMI_DISABLE_IPC=1
 
cd /gpfs/alpine/proj-shared/eng101/Chris/master/example/Bubble/
jsrun --nrs 1 --tasks_per_rs 1 --cpu_per_rs 7 --gpu_per_rs 1  --latency_priority GPU-GPU --launch_distribution packed --smpiargs="-gpu" --bind packed:7 /gpfs/alpine/proj-shared/eng101/Chris/master/tests/lbpm_serial_decomp input.db
jsrun --nrs 8 --tasks_per_rs 1 --cpu_per_rs 7 --gpu_per_rs 1  --latency_priority GPU-GPU --launch_distribution packed --smpiargs="-gpu" --bind packed:7 /gpfs/alpine/proj-shared/eng101/Chris/master/tests/lbpm_color_simulator input.db
