RayTrace {
    geometry = 1
    offset = 0
    upperplate = 0
    lowerplate = 0
    bubbleradius = 0
    bubbleX = 0
    bubbleY = 0
    bubbleZ = 0
}
Color {
    method = 1
    tauA   = 1.0                // relaxation time for fluid A
    tauB   = 1.0                // relaxation time for fluid B
    rhoA   = 1.0                // mass density for fluid A
    rhoB   = 1.0                // mass density for fluid B
    alpha = 0.001               // controls interfacial tension between fluids
    beta  = 0.95                // controls interface width
    F = 0, 0, 0                 // external body force applied to the system
    Restart = false             // restart from checkpoint file?
    din = 1.0                   // density at inlet (if external BC is applied)
    dout = 1.0                  // density at outlet (if external BC is applied )
    timestepMax = 10000             // maximum number of timesteps to simulate
    flux = 0.0                  // volumetric flux in voxels per timestep (if flux BC is applied)
    ComponentLabels = 0         // comma separated list of solid mineral labels
    ComponentAffinity = -0.99   //  1 > affinity > -1, excluding 0
    FluidInitialization = 3     // 1: lbpm_random_pp, 2: lbpm_partial_saturation_pp, 3:lbpm_morphdrain_pp, 4: lbpm_morphopen_pp
    updateQ = false
}
Domain {
    nproc = 2,2,2               // Number of processors
    n = 50,50,50               // Size of local domain
    N = 100,100,100
    nspheres = 60               // Number of spheres (only needed if using a sphere packing)
    L =  1.0,1.0,1.0          // Length of domain (x,y,z)
    BC = 0                      // 0: periodic, 1: periodic pressure, 3: nonperiodic pressure, 4: flux (check these)
    usr = "kbruning"
    filesystem = 0
    RandomSaturation = 0.5      // Morphological wetting phase saturation target      
    InitialSaturation = 0.5
    ReadValues = 0,1,2
    WriteValues = 0,1,2
    legacySDs = false           // old signed distance map
    Berea = false
}
Analysis {
    blobid_interval = 50000000      // Frequency to perform blob identification
    analysis_interval = 1000          // Frequency to perform analysis
    restart_interval = 10000           // Frequency to write restart data
    visualization_interval = 10000   // Frequency to write visualization data
    restart_file = "Restart"        // Filename to use for restart file (will append rank)
    N_threads    = 2                // Number of threads to use
    load_balance = "independent"    // Load balance method to use: "none", "default", "independent"
    CaThreshold = 1E-3
    subdivide = 1,1,1
}
